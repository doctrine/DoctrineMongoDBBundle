includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80400
    level: 7
    paths:
        - config
        - src
        - tests
    excludePaths:
        # Error "overriding property ... should also have native type" is not ignorable
        - src/Validator/Constraints/Unique.php

    ignoreErrors:
        - message: '# with generic class Doctrine\\ODM\\MongoDB\\Mapping\\ClassMetadata#'
          identifier: missingType.generics
        # CollectionDenormalizer is added in symfony/doctrine-bridge 8.2. The service is declared
        # only when the class is available, so this entry can be dropped once 8.2 is required.
        - message: '#^Class Symfony\\Bridge\\Doctrine\\Serializer\\Normalizer\\CollectionDenormalizer not found\.$#'
          identifier: class.notFound
          reportUnmatched: false
