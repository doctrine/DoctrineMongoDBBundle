includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80400
    level: 7
    paths:
        - config
        - src
        - tests
    excludePaths:
        # Error "overriding property ... should also have native type" is not ignorable
        - src/Validator/Constraints/Unique.php

        # The parent class EntityExists exists since symfony/doctrine-bridge 8.2.
        # Error "extends unknown class" is not ignorable, so the file is excluded
        # until 8.2 is required.
        - src/Validator/Constraints/Exists.php

        # TypeProviderGlobalFallback implements TypeProvider, introduced in
        # doctrine/mongodb-odm 2.18. Error "implements unknown interface" is not
        # ignorable, so the file is excluded until 2.18 is required.
        - src/Types/TypeProviderGlobalFallback.php

        # Type declares a final private constructor before doctrine/mongodb-odm 2.18,
        # so a custom type cannot have a constructor with an older version. Error
        # "overrides final method" is not ignorable, so the fixture is excluded.
        - tests/Fixtures/Types18

    ignoreErrors:
        - message: '# with generic class Doctrine\\ODM\\MongoDB\\Mapping\\ClassMetadata#'
          identifier: missingType.generics

        # EntityExistsValidator exists since symfony/doctrine-bridge 8.2. The service is declared
        # only when the class is available, so this entry can be dropped once 8.2 is required.
        - identifier: class.notFound
          path: config/validator.php
          reportUnmatched: false

        # Exists extends EntityExists and ExistsValidatorIntegrationTest uses
        # EntityExistsValidator. Both exist since symfony/doctrine-bridge 8.2.
        # With an older bridge, PHPStan cannot resolve them, so the constraint
        # looks like a class without a constructor. These entries can be dropped
        # once 8.2 is required.
        - identifier: attribute.noConstructor
          path: tests/Validator/Constraints/ExistsTest.php
          reportUnmatched: false
        - identifier: new.noConstructor
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false
        - identifier: argument.type
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false
        - identifier: class.notFound
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false

        # Configuration::getTypeProvider() and TypeRegistry exist since doctrine/mongodb-odm 2.18.
        # With an older version, PHPStan cannot resolve them. These entries can be dropped
        # once 2.18 is required.
        - identifier: method.notFound
          path: tests/DependencyInjection/AbstractMongoDBExtensionTestCase.php
          reportUnmatched: false
        - identifier: class.notFound
          path: tests/DependencyInjection/AbstractMongoDBExtensionTestCase.php
          reportUnmatched: false

        # TypeRegistry::getDeprecatedSharedInstance() exists since doctrine/mongodb-odm 2.18.
        # The method_exists() guard is reported as impossible with an older version and as
        # always true with 2.18. These entries can be dropped once 2.18 is required.
        - identifier: function.impossibleType
          path: src/ManagerConfigurator.php
          reportUnmatched: false
        - identifier: function.alreadyNarrowedType
          path: src/ManagerConfigurator.php
          reportUnmatched: false
