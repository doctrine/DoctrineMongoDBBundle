includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80400
    level: 7
    paths:
        - config
        - src
        - tests
    excludePaths:
        # Error "overriding property ... should also have native type" is not ignorable
        - src/Validator/Constraints/Unique.php

    ignoreErrors:
        - message: '# with generic class Doctrine\\ODM\\MongoDB\\Mapping\\ClassMetadata#'
          identifier: missingType.generics

        # EntityExistsValidator exists since symfony/doctrine-bridge 8.2. The service is declared
        # only when the class is available, so this entry can be dropped once 8.2 is required.
        - identifier: class.notFound
          path: config/validator.php
          reportUnmatched: false

        # DocumentExists extends EntityExists, which exists since symfony/doctrine-bridge 8.2.
        # With an older bridge, the parent class is unknown and PHPStan sees no constructor.
        # This entry can be dropped once 8.2 is required.
        - identifier: attribute.noConstructor
          path: tests/Validator/Constraints/DocumentExistsTest.php
          reportUnmatched: false
