includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80400
    level: 7
    paths:
        - config
        - src
        - tests
    excludePaths:
        # Error "overriding property ... should also have native type" is not ignorable
        - src/Validator/Constraints/Unique.php

        # The parent class EntityExists exists since symfony/doctrine-bridge 8.2.
        # Error "extends unknown class" is not ignorable, so the file is excluded
        # until 8.2 is required.
        - src/Validator/Constraints/Exists.php

    ignoreErrors:
        - message: '# with generic class Doctrine\\ODM\\MongoDB\\Mapping\\ClassMetadata#'
          identifier: missingType.generics

        # EntityExistsValidator exists since symfony/doctrine-bridge 8.2. The service is declared
        # only when the class is available, so this entry can be dropped once 8.2 is required.
        - identifier: class.notFound
          path: config/validator.php
          reportUnmatched: false

        # Exists extends EntityExists and ExistsValidatorIntegrationTest uses
        # EntityExistsValidator. Both exist since symfony/doctrine-bridge 8.2.
        # With an older bridge, PHPStan cannot resolve them, so the constraint
        # looks like a class without a constructor. These entries can be dropped
        # once 8.2 is required.
        - identifier: attribute.noConstructor
          path: tests/Validator/Constraints/ExistsTest.php
          reportUnmatched: false
        - identifier: new.noConstructor
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false
        - identifier: argument.type
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false
        - identifier: class.notFound
          path: tests/Validator/Constraints/ExistsValidatorIntegrationTest.php
          reportUnmatched: false
