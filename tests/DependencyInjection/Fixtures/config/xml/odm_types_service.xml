<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:doctrine="http://symfony.com/schema/dic/doctrine/odm/mongodb"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd
                        http://symfony.com/schema/dic/doctrine/odm/mongodb http://symfony.com/schema/dic/doctrine/odm/mongodb/mongodb-1.0.xsd">

    <doctrine:mongodb type-registry="true">
        <doctrine:connection id="default" server="mongodb://localhost:27017" />
        <doctrine:document-manager id="default" connection="default" />
        <doctrine:type name="custom_type_shortcut" class="Vendor\Type\CustomTypeShortcut" />
        <doctrine:type name="custom_type" class="Vendor\Type\CustomType" />
        <doctrine:type name="service_type_shortcut" service="app.mongodb.custom_type_service" />
        <doctrine:type name="service_type" service="app.mongodb.custom_type_service" />
    </doctrine:mongodb>
    <services>
        <service id="Vendor\Type\CustomTypeWithTag">
            <tag name="doctrine_mongodb.odm.field_type" type="custom_type_with_tag" />
        </service>
        <service id="Vendor\Type\CustomTypeWithTagAndDefaultManager">
            <tag name="doctrine_mongodb.odm.field_type" type="custom_type_with_tag_and_default_manager" object-manager="default" />
        </service>
        <service id="Vendor\Type\CustomTypeWithTagOtherManager">
            <tag name="doctrine_mongodb.odm.field_type" type="custom_type_with_tag_and_other_manager" object-manager="other" />
        </service>
    </services>
</container>
