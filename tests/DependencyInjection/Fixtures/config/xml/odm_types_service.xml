<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:doctrine="http://symfony.com/schema/dic/doctrine/odm/mongodb"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd
                        http://symfony.com/schema/dic/doctrine/odm/mongodb http://symfony.com/schema/dic/doctrine/odm/mongodb/mongodb-1.0.xsd">

    <doctrine:mongodb>
        <doctrine:connection id="default" server="mongodb://localhost:27017" />
        <doctrine:document-manager id="default" connection="default" />
        <doctrine:document-manager id="other" connection="default" />
        <doctrine:type name="custom_type_shortcut" class="Doctrine\Bundle\MongoDBBundle\Tests\Fixtures\Types\CustomTypeService" />
        <doctrine:type name="custom_type" class="Doctrine\Bundle\MongoDBBundle\Tests\Fixtures\Types\CustomTypeService" />
    </doctrine:mongodb>
    <services>
        <defaults autoconfigure="true" />
        <prototype namespace="Doctrine\Bundle\MongoDBBundle\Tests\Fixtures\Types\" resource="../../../../Fixtures/Types"/>
        <service id="app.mongodb.manually_tagged_type" class="Doctrine\Bundle\MongoDBBundle\Tests\Fixtures\Types\CustomTypeService">
            <tag name="doctrine_mongodb.odm.field_type" type="manual_tag_type" />
        </service>
    </services>
</container>
